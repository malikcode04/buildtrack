{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend/buildtrack-frontend && npm install && npm run build",
  "outputDirectory": "frontend/buildtrack-frontend/dist/buildtrack-frontend/browser",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
